# Copy to .env.local and fill in. Every var here must also exist in the
# ARCHITECTURE.md table and the Vercel project config, added in the same commit
# as the code that reads it (data law 7).

# ---------------------------------------------------------------------------
# Database: Neon Postgres, provisioned through the Vercel Marketplace
# ---------------------------------------------------------------------------
# Both of these arrive automatically with `vercel env pull`. Do not hand edit.

# Pooled connection, through PgBouncer. Every request handler uses this.
DATABASE_URL=

# Direct connection. Migrations and importers use this, because the pooler does
# not carry session level state such as advisory locks. Using the pooled URL for
# a migration appears to work and then fails under concurrency.
DATABASE_URL_UNPOOLED=

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------

# Not used. Sessions are database backed: the cookie holds an opaque row id and
# every request checks that row and its expiry, so there is nothing to sign.
# The variable is kept listed only so that finding it set somewhere does not
# read as a missing feature.
#
# The emergency lever is `delete from sessions`, which signs everyone out.
# SESSION_SECRET=

# Absolute origin, so auth redirects land on the right host in deployed
# environments. Leave unset locally.
# NEXT_PUBLIC_SITE_URL=https://alac-os.vercel.app

# ---------------------------------------------------------------------------
# The reasoning layer (see AI.md)
# ---------------------------------------------------------------------------

# Server only, never NEXT_PUBLIC_. Unset is a supported state: deterministic
# scoring still runs and the UI says the reasoning pass is disabled. It never
# invents prose to fill the gap.
OPENAI_API_KEY=

# Model override. Changing this means changing MODEL_RATES in
# src/lib/server/ai/pricing.ts in the same commit, or agent_runs.cost_usd lies.
# OPENAI_MODEL=

# ---------------------------------------------------------------------------
# Importers
# ---------------------------------------------------------------------------

# Absolute path to the directory holding the real client data, which is
# deliberately outside this public repo. Read at import time only, never by the
# running app.
#
# `npm run import:desk` expects "ALAC Desk Command Center.xlsx" in here.
ALAC_DATA_DIR=

# ---------------------------------------------------------------------------
# Signal sources
# ---------------------------------------------------------------------------

# Apify. Job postings only, because Fiber bills one credit per posting found
# and the working market holds tens of thousands of open roles: about 24,000
# Fiber credits versus roughly ten dollars of Apify.
#
# Signals stay on Fiber. Apify scrapes on demand, it does not watch, and
# rebuilding a signal feed out of scheduled scrapes is a lot of moving parts
# to replace something that already works and is free.
#
# Free tier includes $5 of monthly usage, which covers a full job pull.
# Get a token at https://console.apify.com/settings/integrations
APIFY_TOKEN=

# The actor to use for job postings. Overridable because actors get renamed,
# deprecated, or break when LinkedIn changes its markup, and swapping one
# should not need a code change.
# APIFY_JOBS_ACTOR=valig/linkedin-jobs-scraper

# Prospeo. People, work emails, and the company domain lookup that replaced
# guessing a domain from the company name.
#
# One credit per search request that returns at least one person, not one per
# person, so a broad search costs the same as a narrow one.
# Get a key at https://app.prospeo.io/settings/api
PROSPEO_API_KEY=

# PredictLeads. The signal feed: funding, headcount, executive moves,
# office openings, acquisitions. Replaces Fiber.
#
# Two headers, both required. A request missing either is a 401.
# Get credentials at https://predictleads.com
PREDICTLEADS_API_KEY=
PREDICTLEADS_API_TOKEN=
