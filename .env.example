# Copy to .env.local and fill in. Every var here must also exist in the
# ARCHITECTURE.md table and the Vercel project config, added in the same commit
# as the code that reads it (data law 7).

# ---------------------------------------------------------------------------
# Database: Neon Postgres, provisioned through the Vercel Marketplace
# ---------------------------------------------------------------------------
# Both of these arrive automatically with `vercel env pull`. Do not hand edit.

# Pooled connection, through PgBouncer. Every request handler uses this.
DATABASE_URL=

# Direct connection. Migrations and importers use this, because the pooler does
# not carry session level state such as advisory locks. Using the pooled URL for
# a migration appears to work and then fails under concurrency.
DATABASE_URL_UNPOOLED=

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------

# Signs the session cookie. Generate with:  openssl rand -base64 32
# Rotating it signs everyone out, which is the intended emergency lever.
# Unset: auth refuses to start rather than falling back to a default, because a
# predictable signing key is the same as no signing key.
SESSION_SECRET=

# Absolute origin, so auth redirects land on the right host in deployed
# environments. Leave unset locally.
# NEXT_PUBLIC_SITE_URL=https://alac-os.vercel.app

# ---------------------------------------------------------------------------
# The reasoning layer (see AI.md)
# ---------------------------------------------------------------------------

# Server only, never NEXT_PUBLIC_. Unset is a supported state: deterministic
# scoring still runs and the UI says the reasoning pass is disabled. It never
# invents prose to fill the gap.
OPENAI_API_KEY=

# Model override. Changing this means changing MODEL_RATES in
# src/lib/server/ai/pricing.ts in the same commit, or agent_runs.cost_usd lies.
# OPENAI_MODEL=

# ---------------------------------------------------------------------------
# Importers
# ---------------------------------------------------------------------------

# Absolute path to the client workspace holding the real CSVs. That data is
# deliberately outside this public repo. Read at import time only, never by the
# running app.
ALAC_DATA_DIR=

# ---------------------------------------------------------------------------
# Phase 2
# ---------------------------------------------------------------------------

# Read-oriented sync of activity and replies. See ARCHITECTURE.md section 9:
# their API terms restrict combining the API with AI technologies without prior
# written approval, so this stays unset until that confirmation exists. The CSV
# bridge covers the same code path meanwhile.
# SOURCEWHALE_API_KEY=

# Shared secret for scheduled runs.
# CRON_SECRET=

# Password for `npm run create:user`. Unset means one is generated and
# printed once. Never commit a real value.
ALAC_SEED_PASSWORD=
